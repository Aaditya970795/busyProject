# Base URL for the API. Leave unset — this should stay unset in every normal deployment of this
# app, including production.
#
# Locally, Vite's dev proxy (vite.config.js) forwards "/api" to the local server, so client and
# server share an origin. On Vercel, client/api/proxy.js (a Serverless Function) proxies
# "/api/*" to the deployed Render backend, so the browser still only ever talks to one origin (the
# Vercel domain) — this is deliberate, not a shortcut: the login cookie is set by whatever host the
# browser thinks it's talking to, and a genuinely cross-site request (client calling the Render
# URL directly) gets treated as a third-party cookie by the browser and silently blocked in
# Incognito/private browsing (and increasingly in normal browsing too). Routing through the same
# origin avoids that entirely. (A plain vercel.json `rewrites` entry to the external URL doesn't
# work for this — it only reliably proxies GET/HEAD; every POST came back a 405 from Vercel's own
# edge without ever reaching Render.)
#
# Only set this if you're deploying somewhere without an equivalent serverless/proxy capability and
# are accepting the direct-cross-origin tradeoff above — point it at the deployed server's absolute
# URL, including the "/api" prefix, e.g.: VITE_API_BASE_URL="https://your-app.onrender.com/api"
VITE_API_BASE_URL=

# Required on Vercel — read by client/api/proxy.js (a Serverless Function), NOT by the Vite
# build, which is why it has no VITE_ prefix: that prefix means "expose this to the public browser
# bundle," and this value is only ever used server-side, inside the proxy function itself. Set it
# to the deployed Render backend's origin, no trailing slash and no "/api" suffix (the function
# appends the path itself), e.g.: API_ORIGIN="https://your-app.onrender.com"
API_ORIGIN=
