# Supabase Postgres connection string (Session pooler or direct connection)
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# Secret used to sign/verify JWTs — use a long random string in real environments
JWT_SECRET="replace-with-a-long-random-secret"

# Port the Express server listens on
PORT=4000

# Origin the client is served from, used for CORS
CLIENT_ORIGIN="http://localhost:5173"

# An open order (not yet Ready/Served/Cancelled) alerts once it's been open longer than this
SLOW_ORDER_MINUTES=15

# Once an alert is acknowledged, it stays cleared for this long before it's allowed to reappear
# (only if the order is still not Ready by then)
ALERT_REAPPEAR_MINUTES=10

# An alerting order this far overdue is flagged as "critical" instead of just "slow" in the UI
CRITICAL_ORDER_MINUTES=30

# A placed/accepted order left this long with no action gets auto-cancelled, freeing its table.
# Never applies once an order is "preparing" — the kitchen has already started on it by then.
AUTO_CLEAR_MINUTES=45
