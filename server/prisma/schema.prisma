// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  manager
  waiter
}

enum OrderStatus {
  placed
  accepted
  preparing
  ready
  served
  cancelled
}

enum LineStatus {
  active
  void
}

enum EventType {
  status_change
  line_added
  line_voided
  note
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())

  orders                Order[]
  collaborating         OrderCollaborator[]
  orderEvents           OrderEvent[]
  alertAcknowledgements Order[]             @relation("OrderAlertAcknowledgedBy")
}

model Table {
  id         String   @id @default(uuid())
  number     Int      @unique
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model MenuItem {
  id          String   @id @default(uuid())
  name        String
  price       Decimal  @db.Decimal(10, 2)
  isAvailable Boolean  @default(true)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderLines OrderLine[]
}

model Order {
  id                    String      @id @default(uuid())
  tableNumber           Int
  status                OrderStatus @default(placed)
  primaryWaiterId       String
  primaryWaiter         User        @relation(fields: [primaryWaiterId], references: [id])
  isArchived            Boolean     @default(false)
  alertAcknowledgedAt   DateTime?
  alertAcknowledgedById String?
  alertAcknowledgedBy   User?       @relation("OrderAlertAcknowledgedBy", fields: [alertAcknowledgedById], references: [id])
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  lines         OrderLine[]
  collaborators OrderCollaborator[]
  events        OrderEvent[]

  @@index([status])
  @@index([createdAt])
  @@index([primaryWaiterId])
  @@index([tableNumber])
}

model OrderLine {
  id                  String     @id @default(uuid())
  orderId             String
  order               Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId          String
  menuItem            MenuItem   @relation(fields: [menuItemId], references: [id])
  quantity            Int
  specialInstructions String?
  unitPrice           Decimal    @db.Decimal(10, 2)
  status              LineStatus @default(active)
  voidReason          String?
  createdAt           DateTime   @default(now())

  @@index([orderId])
}

model OrderCollaborator {
  orderId  String
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  waiterId String
  waiter   User     @relation(fields: [waiterId], references: [id])
  addedAt  DateTime @default(now())

  @@id([orderId, waiterId])
  @@index([waiterId])
}

// The audit trail for an order: one row per status change, line added, line voided, or note.
// Written alongside the mutation it records, in the same `$transaction`, and never updated or
// deleted afterward by any code path — see the controller for that hard rule.
model OrderEvent {
  id        String    @id @default(uuid())
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventType EventType
  oldValue  String?
  newValue  String?
  // Null means the system did this, not a person — the only case today is the auto-clear sweep
  // cancelling a stuck order with nobody behind it.
  actorId   String?
  actor     User?     @relation(fields: [actorId], references: [id])
  note      String?
  createdAt DateTime  @default(now())

  @@index([orderId])
}
