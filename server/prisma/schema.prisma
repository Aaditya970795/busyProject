// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  manager
  waiter
}

enum OrderStatus {
  placed
  accepted
  preparing
  ready
  served
  cancelled
}

enum LineStatus {
  active
  void
}

enum EventType {
  status_change
  line_added
  line_voided
  note
  order_deleted
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  // A deactivated account can't log in, and an existing session stops working on its very next
  // request (requireAuth re-reads this on every call, same mechanism decision #29 already relies
  // on for a demoted user's stale token). Never a hard delete — see decision #58/#63's reasoning,
  // now applied to staff accounts: primaryWaiterId/waiterId/actorId all reference User with no
  // cascade, so a real delete would be rejected by the database the moment they have any order
  // history at all.
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  orders                Order[]
  collaborating         OrderCollaborator[]
  orderEvents           OrderEvent[]
  alertAcknowledgements Order[]             @relation("OrderAlertAcknowledgedBy")
  deletedOrders         Order[]             @relation("OrderDeletedBy")
  notifications         Notification[]
}

model Table {
  id         String   @id @default(uuid())
  number     Int      @unique
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model MenuItem {
  id          String   @id @default(uuid())
  name        String
  price       Decimal  @db.Decimal(10, 2)
  isAvailable Boolean  @default(true)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderLines OrderLine[]
}

model Order {
  id                    String      @id @default(uuid())
  tableNumber           Int
  status                OrderStatus @default(placed)
  primaryWaiterId       String
  primaryWaiter         User        @relation(fields: [primaryWaiterId], references: [id])
  isArchived            Boolean     @default(false)
  alertAcknowledgedAt   DateTime?
  alertAcknowledgedById String?
  alertAcknowledgedBy   User?       @relation("OrderAlertAcknowledgedBy", fields: [alertAcknowledgedById], references: [id])
  // A "deleted" order is never actually removed from the database — see decision #76. Setting
  // this instead of hard-deleting the row means OrderLine/OrderCollaborator/OrderEvent (all
  // onDelete: Cascade on order) never fire, so the order's full history survives its own deletion
  // and stays visible via GET /orders/:id and /orders/:id/timeline, just hidden from every normal
  // active-order query (list, mine, export, dashboard, alerts, table occupancy).
  deletedAt             DateTime?
  deletedById           String?
  deletedBy             User?       @relation("OrderDeletedBy", fields: [deletedById], references: [id])
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  lines         OrderLine[]
  collaborators OrderCollaborator[]
  events        OrderEvent[]
  notifications Notification[]

  @@index([status])
  @@index([createdAt])
  @@index([primaryWaiterId])
  @@index([tableNumber])
  @@index([deletedAt])
}

model OrderLine {
  id                  String     @id @default(uuid())
  orderId             String
  order               Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId          String
  menuItem            MenuItem   @relation(fields: [menuItemId], references: [id])
  quantity            Int
  specialInstructions String?
  unitPrice           Decimal    @db.Decimal(10, 2)
  status              LineStatus @default(active)
  voidReason          String?
  createdAt           DateTime   @default(now())

  @@index([orderId])
}

model OrderCollaborator {
  orderId  String
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  waiterId String
  waiter   User     @relation(fields: [waiterId], references: [id])
  addedAt  DateTime @default(now())

  @@id([orderId, waiterId])
  @@index([waiterId])
}

// The audit trail for an order: one row per status change, line added, line voided, or note.
// Written alongside the mutation it records, in the same `$transaction`, and never updated or
// deleted afterward by any code path — see the controller for that hard rule.
model OrderEvent {
  id        String    @id @default(uuid())
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventType EventType
  oldValue  String?
  newValue  String?
  // Null means the system did this, not a person — the only case today is the auto-clear sweep
  // cancelling a stuck order with nobody behind it.
  actorId   String?
  actor     User?     @relation(fields: [actorId], references: [id])
  note      String?
  createdAt DateTime  @default(now())

  @@index([orderId])
}

// A personal inbox row, polled by the recipient's own browser (no push channel in this app — see
// decision #56/#66) and shown as a toast once, then marked read. The only producer today is the
// auto-clear sweep telling a waiter their order got cancelled out from under them, but the shape
// isn't specific to that — any future "tell this one user something" case can reuse it.
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId, readAt])
}
