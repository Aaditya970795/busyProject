// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  manager
  waiter
}

enum OrderStatus {
  placed
  accepted
  preparing
  ready
  served
  cancelled
}

enum LineStatus {
  active
  void
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())

  orders        Order[]
  collaborating OrderCollaborator[]
}

model Table {
  id         String   @id @default(uuid())
  number     Int      @unique
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model MenuItem {
  id          String   @id @default(uuid())
  name        String
  price       Decimal  @db.Decimal(10, 2)
  isAvailable Boolean  @default(true)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderLines OrderLine[]
}

model Order {
  id              String      @id @default(uuid())
  tableNumber     Int
  status          OrderStatus @default(placed)
  primaryWaiterId String
  primaryWaiter   User        @relation(fields: [primaryWaiterId], references: [id])
  isArchived      Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  lines         OrderLine[]
  collaborators OrderCollaborator[]
}

model OrderLine {
  id                  String     @id @default(uuid())
  orderId             String
  order               Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId          String
  menuItem            MenuItem   @relation(fields: [menuItemId], references: [id])
  quantity            Int
  specialInstructions String?
  unitPrice           Decimal    @db.Decimal(10, 2)
  status              LineStatus @default(active)
  voidReason          String?
  createdAt           DateTime   @default(now())
}

model OrderCollaborator {
  orderId  String
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  waiterId String
  waiter   User     @relation(fields: [waiterId], references: [id])
  addedAt  DateTime @default(now())

  @@id([orderId, waiterId])
}
